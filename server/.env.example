# Copy to .env and fill in.
#
# DATABASE_URL must use Supabase's transaction pooler (port 6543): a serverless
# function opens a connection per invocation and Postgres runs out of slots long
# before the traffic gets interesting.
#
# DIRECT_URL must use the session pooler (port 5432). Prisma Migrate takes an
# advisory lock, which PgBouncer's transaction mode cannot hold. The
# `db.<ref>.supabase.co` host resolves to IPv6 only and is unreachable from
# Vercel, so use the pooler hostname for both.

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Any long random string. Rotating it invalidates every issued token.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Any OpenAI-compatible endpoint. Nothing in the code is vendor-specific, so
# switching provider is these variables and nothing else.
LLM_PROVIDER="deepseek"
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"
LLM_API_KEY="sk-replace-me"

# Dollars per million tokens, used to price each call. Update them when the
# provider does, or the cost panel quietly drifts away from the real bill.
LLM_INPUT_PRICE="0.27"
LLM_OUTPUT_PRICE="1.10"

PORT=8080

# Comma-separated list of browser origins allowed to call the API.
APP_CORS_ALLOWED_ORIGINS="http://localhost:3000"
